{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 (J-Link GDB Server)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/NW.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "E:/STM32/toolchain/14.3-rel1/bin/arm-none-eabi-gdb.exe",
            "debugServerPath": "E:/STM32/JLink/V794k/JLinkGDBServerCL.exe",
            "debugServerArgs": "-device STM32F103C8 -if SWD -speed 4000 -port 2331 -singlerun -Silent",
            "serverStarted": "Connected to target",
            "stopAtEntry": true,
            "externalConsole": false,
            "setupCommands": [
                { "description": "启用 pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
